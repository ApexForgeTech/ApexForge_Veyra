<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080A"
    tools:context=".MainActivity">

    <!-- Browser chrome -->
    <LinearLayout
        android:id="@+id/browser_toolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#05080A"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:text="‹"
            android:textSize="22sp"
            android:textColor="@color/veyra_text"
            android:background="@drawable/chrome_button"
            android:contentDescription="Back" />

        <Button
            android:id="@+id/btn_forward"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:text="›"
            android:textSize="22sp"
            android:textColor="@color/veyra_text"
            android:background="@drawable/chrome_button"
            android:contentDescription="Forward" />

        <EditText
            android:id="@+id/address_bar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:selectAllOnFocus="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:hint="Search or enter address"
            android:textColor="@color/veyra_text"
            android:textColorHint="@color/veyra_muted"
            android:textSize="14sp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="@drawable/address_pill" />

        <Button
            android:id="@+id/btn_reload"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="↻"
            android:textSize="19sp"
            android:textColor="@color/veyra_text"
            android:background="@drawable/chrome_button"
            android:contentDescription="Reload" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/page_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone"
        android:progressTint="@color/veyra_accent"
        android:progressBackgroundTint="#0B1628"
        app:layout_constraintTop_toBottomOf="@id/browser_toolbar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Main Browser View -->
    <WebView
        android:id="@+id/content_webview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#05080A"
        app:layout_constraintTop_toBottomOf="@id/page_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Overlay Sidebar / Security Panel (Hidden by default) -->
    <FrameLayout
        android:id="@+id/sidebar_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="16dp"
        android:background="@drawable/panel_surface"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintWidth_percent="0.86"
        app:layout_constraintTop_toBottomOf="@id/browser_toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="14dp"
                android:paddingRight="10dp"
                android:background="#07101E">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Veyra Guard"
                    android:textColor="@color/veyra_text"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_close_panel"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:text="×"
                    android:textSize="22sp"
                    android:textColor="@color/veyra_text"
                    android:background="@drawable/chrome_button"
                    android:contentDescription="Close security panel" />
            </LinearLayout>

            <WebView
                android:id="@+id/ui_webview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>

    <!-- Floating Veyra Toggle Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_toggle_panel"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:contentDescription="Veyra security panel"
        android:src="@drawable/ic_veyra_shield"
        app:backgroundTint="#0D1624"
        app:borderWidth="0dp"
        app:elevation="10dp"
        app:tint="#5CC4FF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:fabSize="normal" />

</androidx.constraintlayout.widget.ConstraintLayout>
