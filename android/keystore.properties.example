# Copy to android/keystore.properties (git-ignored) and fill in real values to
# sign release builds with your own key. If this file is absent, the build
# falls back to /mnt/zboth/veyra-key.jks, then to the debug key.
storeFile=/mnt/zboth/veyra-key.jks
storePassword=CHANGEME
keyAlias=veyra
keyPassword=CHANGEME
